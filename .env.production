# Production build configuration (used automatically by `vite build`).
# Relative base URL => same origin as the page => served through Nginx,
# proxied to Spring Boot, and CORS never applies.
# VITE_REACT_APP_BASE_URL=http://10.240.129.37:9000/changemanagement-test
VITE_CAB_USE_MOCK=false

# SPA deployment context path (Vite `base` / BrowserRouter basename source of
# truth - see vite.config.ts and src/App.tsx). Must match the Nginx location
# block the build is served from (see deployment/nginx/*). Change this, not
# the source code, to retarget a deployment.
VITE_APP_BASE_PATH=/airtelcms/


VITE_REACT_APP_BASE_URL=https://chngmgmt.airtel.com:9443/airtelcms


