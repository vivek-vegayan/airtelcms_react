
# main ip address for development
# VITE_REACT_APP_BASE_URL=http://192.168.0.29:1857
# VITE_REACT_APP_BASE_URL=http://192.168.0.54:1857
# VITE_REACT_APP_BASE_URL=http://192.168.1.8:1857
VITE_REACT_APP_BASE_URL=http://192.168.0.50:1857
# VITE_REACT_APP_BASE_URL=http://192.168.0.106:1857

# VITE_REACT_APP_BASE_URL=http://192.168.1.36:1857

# VITE_REACT_APP_BASE_URL=http://172.20.10.2:1857
VITE_CAB_USE_MOCK=false

# SPA deployment context path (Vite `base` / BrowserRouter basename source of
# truth - see vite.config.ts and src/App.tsx). Must match the Nginx location
# block the build is served from. Change this, not the source code, to
# retarget a deployment.
VITE_APP_BASE_PATH=/airtelcms/

